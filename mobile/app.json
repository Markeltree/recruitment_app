{
  "expo": {
    "name": "ApplyUp",
    "slug": "applyup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "applyup",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#2F6BFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.applyup.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6BFF"
      },
      "package": "app.applyup.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ionicons.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://recruitment-app-puce.vercel.app/api/v1",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "81d0cc94-dd50-4ad6-8540-0184228078c0"
      }
    }
  }
}
