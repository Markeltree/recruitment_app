{
  "expo": {
    "name": "ApplyUp",
    "slug": "applyup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "applyup",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#2F6BFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.applyup.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6BFF"
      },
      "package": "app.applyup.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://192.168.100.19:5000/api/v1"
    }
  }
}
